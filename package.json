{
  "name": "minedock",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first Minecraft server manager",
  "author": "MineDock contributors",
  "homepage": "https://github.com/Bobydeluxe/MineDock",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "build": "pnpm typecheck && vite build && node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:live": "node scripts/smoke-live.mjs",
    "test:official": "node scripts/check-official.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "screenshots": "node scripts/capture-ui.mjs",
    "build:site": "node scripts/build-site.mjs",
    "updates:keygen": "node scripts/create-update-key.mjs",
    "updates:sign": "node scripts/sign-update.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:windows": "pnpm build && node scripts/package.mjs windows",
    "build:linux": "pnpm build && node scripts/package.mjs linux",
    "build:mac": "pnpm build && node scripts/package.mjs mac",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@tanstack/react-virtual": "^3.13.0",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.27.0",
    "lucide-react": "^0.468.0",
    "pidusage": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.8.5",
    "tar": "^7.5.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "app.minedock.desktop",
    "productName": "MineDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "apps/desktop/assets/icon.ico"
    },
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "MineDock-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MineDock-${version}-Portable-${arch}.${ext}"
    },
    "linux": {
      "executableName": "minedock",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Bobydeluxe <337467661+Bobydeluxe@users.noreply.github.com>",
      "icon": "apps/desktop/assets/icon.png"
    },
    "mac": {
      "icon": "apps/desktop/assets/icon.icns",
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "publish": null
  }
}
