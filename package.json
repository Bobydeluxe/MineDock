{
  "name": "minedock",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first Minecraft server manager",
  "author": "MineDock contributors",
  "homepage": "https://github.com/Bobydeluxe/MineDock",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "build": "pnpm typecheck && vite build && node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:live": "node scripts/smoke-live.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:windows": "pnpm build && electron-builder --win nsis portable",
    "build:linux": "pnpm build && electron-builder --linux AppImage deb",
    "build:mac": "pnpm build && electron-builder --mac dmg",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "lucide-react": "^0.468.0",
    "pidusage": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tar": "^7.5.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "app.minedock.desktop",
    "productName": "MineDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "apps/desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "MineDock-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MineDock-${version}-Portable-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Bobydeluxe <337467661+Bobydeluxe@users.noreply.github.com>",
      "icon": "apps/desktop/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "publish": null
  }
}
